# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Credenciais AWS para o backend (DynamoDB). Gere uma Access Key para um usuário
# IAM com permissão nas tabelas Folio* e cole os valores reais no seu .env local
# (nunca commitado — veja .gitignore).
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"
AWS_REGION="us-east-2"

# Segredo usado para assinar os JWTs de autenticação. Qualquer string longa e
# aleatória serve; se ausente, cai num valor padrão só para desenvolvimento.
JWT_SECRET="YOUR_JWT_SECRET"
